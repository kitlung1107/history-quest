rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function teacher() {
      return signed() && request.auth.token.email == 'kitlung1107@gmail.com';
    }
    function owns(sid) {
      return signed() && (exists(/databases/$(database)/documents/access/$(request.auth.token.email))
          && get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId == sid
          && get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.enabled == true);
    }
    // This grants card selection only. It is never used by teacher(), taskAllowed(),
    // roster access or CMS. Identity comes from the verified Firebase token.
    function fullCardAccount(sid) {
      return signed()
        && request.auth.token.email in ['tangkl@ctshkpcc.edu.hk', 'kitlung1107@gmail.com']
        && (owns(sid) || (teacher() && sid == request.auth.uid
          && !exists(/databases/$(database)/documents/access/$(request.auth.token.email))));
    }
    function enabledCatalogCard(id) {
      let path = /databases/$(database)/documents/cardCatalog/current;
      return exists(path) && get(path).data.schemaVersion == 1
        && get(path).data.cards is map && id in get(path).data.cards
        && get(path).data.cards[id].enabled == true
        && get(path).data.cards[id].role in ['studentBoy', 'studentGirl'];
    }
    // Retaining an old selection is not a new grant. This lets gift top-ups and
    // teacher roster edits work after a card is removed/disabled. UI hides it.
    function retainedCard(d, sid) {
      let path = /databases/$(database)/documents/profiles/$(sid);
      return exists(path) && get(path).data.get('role', '') in ['studentBoy', 'studentGirl']
        && get(path).data.role == d.role && get(path).data.get('cardId', '') == d.cardId;
    }
    function selectedCardOK(d, sid) {
      return fullCardAccount(sid)
        ? (enabledCatalogCard(d.cardId) || retainedCard(d, sid))
        : (d.cardId in d.ownedCardIds || (teacher() && retainedCard(d, sid)));
    }
    match /cardCatalog/{card} {
      // Only the separately reviewed privileged release tool can sync metadata.
      // No client (including the existing teacher) can mint catalogue entries.
      allow read, write: if false;
    }
    // Grade comes only from the teacher-managed profile, never the submitted payload.
    function rosterGrade(sid) {
      let c = get(/databases/$(database)/documents/profiles/$(sid)).data.className;
      return c.matches('[ ]*([sS中]?[1一]([A-Ea-e]|班)?)[ ]*') ? 1
        : c.matches('[ ]*([sS中]?[2二]([A-Ea-e]|班)?)[ ]*') ? 2
        : c.matches('[ ]*([sS中]?[3三]([A-Ea-e]|班)?)[ ]*') ? 3
        : c.matches('[ ]*([sS中]?[4四]([A-Ea-e]|班)?)[ ]*') ? 4
        : c.matches('[ ]*([sS中]?[5五]([A-Ea-e]|班)?)[ ]*') ? 5
        : c.matches('[ ]*([sS中]?[6六]([A-Ea-e]|班)?)[ ]*') ? 6 : 0;
    }
    function gradeAllowed(sid, grade) {
      let own = rosterGrade(sid);
      return grade is int && grade >= 1 && grade <= 6
        && ((own >= 1 && own <= 3 && grade == own) || (own >= 4 && grade >= 4 && grade <= own));
    }
    function testingAccount(sid) {
      return owns(sid)
        && get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.get('testing', false) == true;
    }
    function taskAllowed(sid, task) {
      let entry = get(/databases/$(database)/documents/taskAccess/$(task)).data;
      return teacher() || (entry.enabled == true && (testingAccount(sid) || gradeAllowed(sid, entry.grade)));
    }
    match /taskAccess/{task} {
      allow read: if signed();
      allow write: if teacher() && request.resource.data.keys().hasOnly(['grade', 'enabled'])
        && request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 6
        && request.resource.data.enabled is bool;
    }
    function profileOK(d, sid) {
      return d.keys().hasOnly(['className', 'studentNo', 'name', 'nickname', 'avatar', 'configured', 'cardId', 'role', 'ownedCardIds', 'legacyCardId'])
        && (!('cardId' in d) || (d.cardId is string && d.cardId.matches('[A-Za-z0-9_-]{3,80}')))
        && (!('role' in d) || collectionOK(d, sid))
        && (!('ownedCardIds' in d) || 'role' in d)
        && (!('legacyCardId' in d) || d.legacyCardId is string)
        && d.configured is bool
        && d.className is string && d.className.matches('([1-6][A-E]|S[4-6]|Other)')
        && d.studentNo is string && d.studentNo.matches('[A-Z0-9-]{1,12}')
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 50
        && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 20
        && d.avatar in ['explorer', 'scholar', 'archaeologist', 'navigator', 'studentBoy', 'studentGirl', 'detective', 'conservator', 'ancientScholar', 'cartographer'];
    }
    function starter(d) { return d.role == 'studentBoy' ? 'starter-explorer-boy' : 'starter-explorer-girl'; }
    function nile(d) { return d.role == 'studentBoy' ? 'nile-explorer-boy' : 'nile-explorer-girl'; }
    function gifts(d) { return d.className.matches('1[A-E]') ? [starter(d), nile(d)] : [starter(d)]; }
    function collectionOK(d, sid) {
      return d.role in ['studentBoy', 'studentGirl']
        && d.ownedCardIds is list
        && d.ownedCardIds.size() == d.ownedCardIds.toSet().size()
        && d.ownedCardIds.hasOnly([starter(d), nile(d)])
        && d.ownedCardIds.hasAll([starter(d)])
        && selectedCardOK(d, sid);
    }
    function studentCollectionUpdate(sid) {
      let old = resource.data;
      let next = request.resource.data;
      return next.configured == true && collectionOK(next, sid)
        && ((!('role' in old)
          && next.ownedCardIds.toSet() == gifts(next).toSet()
          && ((!('cardId' in old) && !('legacyCardId' in next)) || next.legacyCardId == old.cardId))
        || ('role' in old && next.role == old.role
          && next.ownedCardIds.hasAll(old.ownedCardIds)
          && next.ownedCardIds.hasAll(gifts(next))
          && next.ownedCardIds.hasOnly(old.ownedCardIds.concat(gifts(next)))
          && !next.diff(old).affectedKeys().hasAny(['legacyCardId'])));
    }
    match /access/{email} {
      allow get: if teacher() || (signed() && request.auth.token.email == email);
      allow list: if teacher();
      allow create, update: if teacher() && request.resource.data.keys().hasOnly(['studentId', 'enabled', 'testing'])
        && (!('testing' in request.resource.data) || request.resource.data.testing is bool)
        && request.resource.data.studentId is string && request.resource.data.enabled is bool;
      allow delete: if teacher();
    }
    function requestIdentityOK(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 50
        && d.name.matches('.*[^ ].*')
        && d.className is string && d.className.matches('([1-3][A-E]|S[4-6]|Other)')
        && d.studentNo is string && d.studentNo.matches('[A-Z0-9-]{1,12}');
    }
    function pendingRequestOK(email) {
      return signed() && request.auth.token.email == email && !teacher()
        && (!exists(/databases/$(database)/documents/access/$(email))
          || get(/databases/$(database)/documents/access/$(email)).data.enabled == false)
        && request.resource.data.keys().hasOnly(['name', 'className', 'studentNo', 'status', 'submittedAt'])
        && requestIdentityOK(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time;
    }
    match /accessRequests/{email} {
      allow get: if teacher() || (signed() && request.auth.token.email == email);
      allow list: if teacher();
      allow create: if pendingRequestOK(email);
      allow update: if (resource.data.status == 'rejected' && pendingRequestOK(email))
        || (teacher() && resource.data.status == 'pending'
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'studentId', 'reason'])
          && ((request.resource.data.status == 'rejected'
            && request.resource.data.keys().hasOnly(['name', 'className', 'studentNo', 'status', 'submittedAt', 'reviewedAt', 'reason'])
            && request.resource.data.reason is string && request.resource.data.reason.size() >= 1 && request.resource.data.reason.size() <= 200)
          || (request.resource.data.status == 'approved'
            && request.resource.data.keys().hasOnly(['name', 'className', 'studentNo', 'status', 'submittedAt', 'reviewedAt', 'studentId'])
            && request.resource.data.studentId is string
            && profileOK(getAfter(/databases/$(database)/documents/profiles/$(request.resource.data.studentId)).data, request.resource.data.studentId)
            && getAfter(/databases/$(database)/documents/access/$(email)).data.enabled == true
            && getAfter(/databases/$(database)/documents/access/$(email)).data.studentId == request.resource.data.studentId)));
    }
    match /studentLogins/{sid} {
      allow read: if teacher() || owns(sid);
      allow create: if owns(sid)
        && exists(/databases/$(database)/documents/profiles/$(sid))
        && request.resource.data.keys().hasOnly(['firstLoginAt'])
        && request.resource.data.firstLoginAt == request.time;
      // First successful access is immutable, including across email changes.
      allow update, delete: if false;
    }
    match /profiles/{sid} {
      allow read: if teacher() || owns(sid);
      allow create: if teacher() && profileOK(request.resource.data, sid) && request.resource.data.className.matches('([1-3][A-E]|S[4-6]|Other)');
      allow update: if profileOK(request.resource.data, sid) && (request.resource.data.className.matches('([1-3][A-E]|S[4-6]|Other)') || request.resource.data.className == resource.data.className) && (teacher() || (owns(sid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'configured', 'cardId', 'role', 'ownedCardIds', 'legacyCardId'])
        && studentCollectionUpdate(sid)));
    }
    match /submissions/{attempt} {
      allow get: if teacher() || (resource == null && signed()) || owns(resource.data.studentId);
      allow list: if teacher() || owns(resource.data.studentId);
      allow create: if request.resource.data.get('protocol','') != 'rules-assessment/1'
        && !exists(/databases/$(database)/documents/assessmentVersions/$(request.resource.data.taskId + '--' + request.resource.data.version))
        && (teacher() || owns(request.resource.data.studentId))
        && taskAllowed(request.resource.data.studentId, request.resource.data.taskId)
        && request.resource.data.keys().hasOnly(['studentId', 'taskId', 'version', 'answers', 'createdAt'])
        && request.resource.data.taskId is string && request.resource.data.taskId.size() <= 150
        && request.resource.data.version is string && request.resource.data.version.size() <= 40
        && request.resource.data.answers is list && request.resource.data.answers.size() <= 30
        && request.resource.data.createdAt == request.time
        && (teacher() || exists(/databases/$(database)/documents/profiles/$(request.resource.data.studentId)));
      // Original answers and ownership remain immutable, including after marking.
      allow update: if resource.data.get('protocol','') != 'rules-assessment/1' && teacher() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['grade']);
          allow create: if request.resource.data.get('protocol','') == 'rules-assessment/1' && attempt.matches('[A-Za-z0-9_-]{1,150}') && rrSource(request.resource.data)
        && request.resource.data.keys().hasOnly(['protocol','studentId','taskId','version','answers','createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == rrMeta(request.resource.data).questionCount;
      allow update: if resource.data.get('protocol','') == 'rules-assessment/1' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grade'])
        && rrGrade(resource.data,request.resource.data.grade,attempt)
        && request.resource.data.grade.revision == (('grade' in resource.data) ? resource.data.grade.revision + 1 : 1)
        && (teacher() || (!('grade' in resource.data)
          && request.resource.data.grade.shortMarks.toSet().hasOnly([null])))
        && rrLedgerRequired(resource.data,request.resource.data.grade,attempt);
      allow delete: if false;
    }
    match /progress/{sid}/tasks/{taskId} {
      allow read: if teacher() || owns(sid);
      allow create, update: if getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.get('protocol','') != 'rules-assessment/1' && ( teacher() || (owns(sid)
        && request.resource.data.keys().hasOnly(['score', 'progress', 'attemptId', 'syncedAt'])
        && request.resource.data.score == 0 && request.resource.data.progress == 100
        && request.resource.data.syncedAt == request.time
        && !exists(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId))
        && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.studentId == sid
        && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.taskId == taskId));
          allow create, update: if getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.get('protocol','') == 'rules-assessment/1' && (teacher() || owns(sid))
        && request.resource.data.keys().hasOnly(['score','progress','attemptId','syncedAt'])
        && request.resource.data.progress == 100 && request.resource.data.syncedAt == request.time
        && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.studentId == sid
        && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.taskId == taskId
        && request.resource.data.score == (('grade' in getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data)
          ? (getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.grade.score == null ? 0
            : getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.grade.score) : 0);
      allow delete: if false;
    }
    // Shared game protocol v1: raw answers are immutable and grading is rule-checked.
    function gameOwner(s) {
      return (teacher() || owns(s.studentId)) && request.auth.uid == s.uid;
    }
    function gameVersion(s) {
      let version = get(/databases/$(database)/documents/gameCatalog/$(s.gameId)/versions/$(s.version)).data;
      return version.enabled == true && taskAllowed(s.studentId, version.taskId);
    }
    function answerIndex(a, q, i) {
      return a.size() <= i || (a[i] is int && a[i] >= 0 && a[i] <= q.maxIndex[i]);
    }
    function gameAnswerOK(a, q) {
      return q.validator == 'index-array/1' && a is list && a.size() == q.answer.size()
        && a.size() >= 1 && a.size() <= 8
        && answerIndex(a,q,0) && answerIndex(a,q,1) && answerIndex(a,q,2) && answerIndex(a,q,3)
        && answerIndex(a,q,4) && answerIndex(a,q,5) && answerIndex(a,q,6) && answerIndex(a,q,7)
        && (!q.distinct || a.toSet().size() == a.size());
    }
    match /gameCatalog/{game}/versions/{version} {
      allow read: if signed();
      allow create: if teacher() && request.resource.data.keys().hasOnly(['enabled','title','taskId','questionCount'])
        && request.resource.data.enabled == true;
      allow update: if teacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled'])
        && request.resource.data.enabled is bool;
      match /questions/{question} {
        allow read: if signed();
        allow create: if teacher()
          && !exists(/databases/$(database)/documents/gameCatalog/$(game)/versions/$(version));
        // Identical writes permit a interrupted catalogue upload to retry.
        allow update: if teacher() && request.resource.data == resource.data;
      }
    }
    match /gameSessions/{session} {
      allow get: if teacher() || (resource == null && signed()) || owns(resource.data.studentId);
      allow list: if teacher() || owns(resource.data.studentId);
      allow create: if session.matches('[a-zA-Z0-9-]{1,80}') && gameOwner(request.resource.data)
        && gameVersion(request.resource.data)
        && (teacher() || exists(/databases/$(database)/documents/profiles/$(request.resource.data.studentId)))
        && request.resource.data.keys().hasOnly(['uid','studentId','gameId','version','status','attempts','correct','lastEventId','createdAt'])
        && request.resource.data.status == 'open' && request.resource.data.attempts == 0
        && request.resource.data.correct == 0 && request.resource.data.lastEventId == ''
        && request.resource.data.createdAt == request.time;
      function appendAnswer() {
        let next = request.resource.data;
        let path = /databases/$(database)/documents/gameSessions/$(session)/answers/$(next.lastEventId);
        let answer = getAfter(path).data;
        return next.diff(resource.data).affectedKeys().hasOnly(['attempts','correct','lastEventId'])
          && !exists(path) && next.lastEventId.matches('[a-zA-Z0-9-]{1,80}')
          && next.attempts == resource.data.attempts + 1 && answer.sequence == next.attempts
          && next.correct == resource.data.correct + (answer.correct ? 1 : 0);
      }
      function finishGame() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt'])
          && request.resource.data.status in ['completed','abandoned']
          && request.resource.data.completedAt == request.time;
      }
      allow update: if gameOwner(resource.data) && gameVersion(resource.data) && resource.data.status == 'open'
        && (finishGame() || appendAnswer());
      match /answers/{event} {
        function sessionData() { return get(/databases/$(database)/documents/gameSessions/$(session)).data; }
        function validGameAnswer() {
          let s = sessionData();
          let d = request.resource.data;
          let q = get(/databases/$(database)/documents/gameCatalog/$(s.gameId)/versions/$(s.version)/questions/$(d.questionId)).data;
          let next = getAfter(/databases/$(database)/documents/gameSessions/$(session)).data;
          return gameOwner(s) && gameVersion(s) && s.status == 'open'
            && event.matches('[a-zA-Z0-9-]{1,80}')
            && d.keys().hasOnly(['questionId','answer','correct','sequence','createdAt'])
            && d.questionId is string && gameAnswerOK(d.answer,q)
            && d.correct == (d.answer == q.answer) && d.createdAt == request.time
            && d.sequence == s.attempts + 1 && next.attempts == d.sequence
            && next.lastEventId == event;
        }
        allow read: if teacher() || owns(sessionData().studentId);
        allow create: if validGameAnswer();
      }
    }

    match /coinRules/{task} {
      function studentRewardReader() {
        let sid = get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId;
        return owns(sid) && taskAllowed(sid, task);
      }
      // Students may get settings for an authorised task only. Never expose
      // extra teacher metadata or grant collection listing / setting writes.
      allow get: if teacher() || (signed() && studentRewardReader()
        && (resource == null || resource.data.keys().hasOnly(['mode','amount','metric','tiers'])));
      allow list, write: if teacher();
    }
    match /rewardPolicies/{task} {
      function reader() {
        let sid = get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId;
        return owns(sid) && taskAllowed(sid, task);
      }
      allow get: if teacher() || (signed() && reader()
        && (resource == null || resource.data.keys().hasOnly(['source','enabled'])));
      allow list: if teacher();
      allow write: if teacher() && request.resource.data.keys().hasOnly(['source','enabled'])
        && request.resource.data.source in ['assessment','game','none'] && request.resource.data.enabled is bool;
    }
    match /rewardAutomation/{key} {
      function approved() {
        let sid = get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId;
        return owns(sid);
      }
      allow get: if teacher() || (key == 'status' && signed() && approved()
        && (resource == null || resource.data.keys().hasOnly(['enabled','activatedAt'])));
      allow list: if teacher();
      allow write: if false;
    }
    match /rewardResults/{sid}/attempts/{attempt} {
      allow read: if teacher() || owns(sid);
      allow write: if false;
    }
    match /trustedGameCompletions/{session} {
      allow read: if teacher() || owns(resource.data.studentId);
      allow write: if false;
    }
    match /trustedGameVerifiers/{version} {
      allow read: if teacher();
      allow write: if false;
    }
    match /coinAccounts/{sid}/entries/{entry} {
      allow read: if teacher() || owns(sid);
      function submissionEvidence(d) {
        let s = getAfter(/databases/$(database)/documents/submissions/$(d.attemptId)).data;
        return s.get('protocol','') != 'rules-assessment/1' && s.studentId == sid && s.taskId == entry && s.grade.status == 'graded' && s.grade.score == d.score;
      }
      function gameEvidence(d) {
        let s = get(/databases/$(database)/documents/gameSessions/$(d.attemptId)).data;
        return s.studentId == sid && s.status == 'completed' && s.attempts > 0
          && get(/databases/$(database)/documents/gameCatalog/$(s.gameId)/versions/$(s.version)).data.taskId == entry;
      }
      // Teacher-confirmed grading is the trust boundary. Students cannot mint coins.
      // Positive rewards are immutable; only a legacy zero may be replaced.
      function positiveReward() {
        return teacher()
        && request.resource.data.keys().hasOnly(['kind','taskId','attemptId','amount','score','progress','rule','createdAt'])
        && request.resource.data.taskId == entry
        && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.progress == 100 && request.resource.data.createdAt == request.time
        && ((request.resource.data.kind == 'taskReward' && submissionEvidence(request.resource.data))
          || (request.resource.data.kind == 'gameReward' && gameEvidence(request.resource.data)));
      }
      allow create: if positiveReward();
      allow update: if resource.data.amount == 0 && positiveReward();
      allow delete: if false;
          function rulesReward() {
        let d = request.resource.data;
        let p = /databases/$(database)/documents/submissions/$(d.attemptId);
        let s = getAfter(p).data;
        let previous = get(p).data;
        return rrRewardActive(s) && rrApproved(sid,entry) && s.studentId == sid && s.taskId == entry
          && s.grade.revision == (('grade' in previous) ? previous.grade.revision + 1 : 1)
          && s.grade.status == 'graded' && s.grade.score == d.score && s.grade.rewardAmount == d.amount
          && d.keys().hasOnly(['kind','taskId','attemptId','amount','score','progress','rule','createdAt','tierIndex'])
          && d.kind == 'taskReward' && d.taskId == entry && d.progress == 100
          && d.createdAt == request.time && d.amount > 0 && d.rule == rrRule(entry)
          && d.tierIndex == s.grade.tierIndex;
      }
      allow create: if rulesReward();
      allow update: if resource.data.amount == 0 && rulesReward();
      allow delete: if false;
    }
    match /catalogue/{task} { allow read, write: if teacher(); }
    match /roster/{student} { allow read, write: if teacher(); }
    match /metadata/{key} { allow read, write: if teacher(); }
    // Local App integration. Answers are immutable before any grading probe.
    function rrMeta(s) {
      return get(/databases/$(database)/documents/assessmentVersions/$(s.taskId + '--' + s.version)).data;
    }
    function rrStudentApproved(sid,task) {
      let a = get(/databases/$(database)/documents/access/$(request.auth.token.email)).data;
      let t = get(/databases/$(database)/documents/taskAccess/$(task)).data;
      return signed() && a.enabled == true && a.studentId == sid && t.enabled == true
        && (a.get('testing',false) == true || gradeAllowed(sid,t.grade));
    }
    function rrApproved(sid,task) {
      return teacher() || rrStudentApproved(sid,task);
    }
    function rrSource(s) {
      let m = rrMeta(s);
      return s.protocol == 'rules-assessment/1' && m.enabled == true
        && m.questionCount >= 1 && m.questionCount <= 30
        && m.taskId == s.taskId && m.version == s.version
        && s.createdAt >= m.acceptFrom
        && get(/databases/$(database)/documents/taskAccess/$(s.taskId)).data.enabled == true
        && rrApproved(s.studentId,s.taskId);
    }
    function rrAnswer(m,a,i) {
      return i >= m.questionCount || (a[i].keys().hasOnly(['question_id','value'])
        && a[i].question_id == m.questions[i].id
        && (m.questions[i].type == 'choice'
          ? a[i].value is int && a[i].value >= 0 && a[i].value < m.questions[i].options.size()
          : a[i].value is string && a[i].value.size() > 0 && a[i].value.size() <= 4000));
    }
    function rrShortMark(m,a,i) {
      return i >= m.questionCount || (m.questions[i].type == 'choice' ? a[i] == null
        : a[i] == null || (a[i] is number && a[i] >= 0 && a[i] <= m.questions[i].points));
    }
    function rrFilled(m,a,i) {
      return i >= m.questionCount || m.questions[i].type == 'choice' || a[i] != null;
    }
    function rrShortValue(m,a,i) {
      return i >= m.questionCount ? 0 : (a[i] == null ? 0 : a[i]);
    }
    function rrRule(task) {
      let p = /databases/$(database)/documents/coinRules/$(task);
      return exists(p) ? get(p).data : {'mode':'off','amount':0,'metric':'score','tiers':[]};
    }
    function rrTierBelow(r,v,min,i) {
      return i >= r.tiers.size() || r.tiers[i].minimum > v || r.tiers[i].minimum <= min;
    }
    function rrQuote(r,score,amount,index) {
      let v = r.metric == 'score' ? score : 100;
      return amount is int && amount >= 0 && amount <= 100000 && index is int
        && r.metric in ['score','progress']
        && (r.mode == 'off' ? amount == 0 && index == -1
          : r.mode == 'fixed' ? index == -1 && amount == r.amount
          : r.mode == 'tiers' && r.tiers is list && r.tiers.size() <= 20
            && index >= -1 && index < r.tiers.size()
            && (index == -1 ? amount == 0
              : v >= r.tiers[index].minimum && amount == r.tiers[index].amount
                ));
    }
    function rrGrade(s,g,attempt) {
      let m = rrMeta(s);
      let a = get(/databases/$(database)/documents/assessmentGrading/$(attempt)).data;
      let staged = teacher() && m.shortCount > 0 && g.revision > 1;
      let id = attempt + '--' + string(g.revision);
      let short = staged ? get(/databases/$(database)/documents/assessmentShortGrading/$(id)).data : {'index':m.questionCount,'shortPoints':0,'markedCount':0};
      let complete = short.markedCount == m.shortCount;
      let score = math.round(100.0 * (a.mcPoints + short.shortPoints) / m.totalPoints);
      let quote = complete ? get(/databases/$(database)/documents/assessmentRewardQuotes/$(id)).data : {};
      let r = complete ? rrRule(s.taskId) : {};
      return rrSource(s) && a.index == m.questionCount && a.studentId == s.studentId
        && g.keys().hasOnly(['status','score','mcPoints','shortMarks','revision','rewardAmount','tierIndex'])
        && g.mcPoints == a.mcPoints && g.revision is int && g.revision >= 1
        && g.shortMarks is list && g.shortMarks.size() == m.questionCount
        && (staged ? short.index == m.questionCount
            && g.shortMarks == get(/databases/$(database)/documents/assessmentShortDrafts/$(id)).data.marks
          : g.shortMarks.toSet().hasOnly([null]))
        && (complete ? g.status == 'graded' && g.score == score
              && quote.score == score && quote.amount == g.rewardAmount && quote.tierIndex == g.tierIndex
              && quote.rule == r && quote.checked == (r.mode == 'tiers' ? r.tiers.size() : 0)
          : g.status == 'pending' && g.score == null && g.rewardAmount == 0 && g.tierIndex == -1);
    }
    function rrLedgerRequired(s,g,attempt) {
      let p = /databases/$(database)/documents/coinAccounts/$(s.studentId)/entries/$(s.taskId);
      // The ledger's own write rule verifies exact source/score/amount and an
      // atomic grade revision. Existing positive entries are immutable.
      // Reading the post-transaction entry once covers both cases.
      return g.rewardAmount == 0 || !rrRewardActive(s) || getAfter(p).data.amount > 0;
    }
    function rrRewardActive(s) {
      let p = /databases/$(database)/documents/rewardAutomation/status;
      return exists(p) && get(p).data.enabled == true
        && get(p).data.activatedAt is timestamp && s.createdAt >= get(p).data.activatedAt;
    }
    function rrFeedbackReader(versionId) {
      let sid = get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId;
      let grant = get(/databases/$(database)/documents/assessmentFeedbackAccess/$(sid)/versions/$(versionId)).data;
      let s = get(/databases/$(database)/documents/submissions/$(grant.attemptId)).data;
      return owns(sid) && s.protocol == 'rules-assessment/1' && s.studentId == sid
        && s.taskId + '--' + s.version == versionId && s.grade.status in ['pending','graded']
        && get(/databases/$(database)/documents/assessmentGrading/$(grant.attemptId)).data.index == rrMeta(s).questionCount;
    }
    match /assessmentKeys/{version} {
      allow get: if teacher() || (signed() && rrFeedbackReader(version));
      allow create: if teacher() && request.resource.data.keys().hasOnly(['taskId','version','questions'])
        && version == request.resource.data.taskId + '--' + request.resource.data.version
        && !exists(/databases/$(database)/documents/assessmentVersions/$(version));
      allow update, delete, list: if false;
    }
    match /assessmentFeedbackAccess/{sid}/versions/{versionId} {
      allow get: if teacher() || owns(sid);
      function validFeedback() {
        let d = request.resource.data;
        let s = get(/databases/$(database)/documents/submissions/$(d.attemptId)).data;
        return d.keys().hasOnly(['attemptId','studentId','taskId','version'])
          && rrSource(s) && s.studentId == sid && d.studentId == sid && d.taskId == s.taskId && d.version == s.version
          && versionId == s.taskId + '--' + s.version && s.grade.status in ['pending','graded']
          && get(/databases/$(database)/documents/assessmentGrading/$(d.attemptId)).data.index == rrMeta(s).questionCount;
      }
      allow create, update: if validFeedback();
      allow delete, list: if false;
    }
    match /assessmentVersions/{version} {
      allow get: if teacher() || (signed()
        && owns(get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId)
        && taskAllowed(get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId,resource.data.taskId));
      function publicQuestion(d,i) {
        // Only the verified teacher can publish. Detailed shape/points checks
        // run in the CMS/exporter; the rule enforces secrecy for every question
        // without exceeding the 1000-expression limit for 30-question saves.
        return i >= d.questionCount || d.questions[i].keys().hasOnly(['id','type','prompt','points','options','image','imagePosition']);
      }
      function publicQuestions(d) {
        return publicQuestion(d,0) && publicQuestion(d,1) && publicQuestion(d,2) && publicQuestion(d,3) && publicQuestion(d,4)
          && publicQuestion(d,5) && publicQuestion(d,6) && publicQuestion(d,7) && publicQuestion(d,8) && publicQuestion(d,9)
          && publicQuestion(d,10) && publicQuestion(d,11) && publicQuestion(d,12) && publicQuestion(d,13) && publicQuestion(d,14)
          && publicQuestion(d,15) && publicQuestion(d,16) && publicQuestion(d,17) && publicQuestion(d,18) && publicQuestion(d,19)
          && publicQuestion(d,20) && publicQuestion(d,21) && publicQuestion(d,22) && publicQuestion(d,23) && publicQuestion(d,24)
          && publicQuestion(d,25) && publicQuestion(d,26) && publicQuestion(d,27) && publicQuestion(d,28) && publicQuestion(d,29);
      }
      allow create: if teacher() && request.resource.data.keys().hasOnly(['taskId','version','title','questions','questionCount','shortCount','totalPoints','enabled','acceptFrom'])
        && version == request.resource.data.taskId + '--' + request.resource.data.version
        && request.resource.data.acceptFrom == request.time
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount >= 1 && request.resource.data.questionCount <= 30
        && request.resource.data.questions.size() == request.resource.data.questionCount
        && publicQuestions(request.resource.data)
        && getAfter(/databases/$(database)/documents/assessmentKeys/$(version)).data.questions is list;
      allow update, delete, list: if false;
    }

    match /assessmentGrading/{attempt} {
      function source() { return get(/databases/$(database)/documents/submissions/$(attempt)).data; }
      allow get: if teacher() || (resource == null && signed()) || owns(resource.data.studentId);
      allow create: if rrSource(source())
        && request.resource.data.keys().hasOnly(['studentId','taskId','version','index','mcPoints'])
        && request.resource.data.studentId == source().studentId && request.resource.data.taskId == source().taskId
        && request.resource.data.version == source().version && request.resource.data.mcPoints == 0
        && request.resource.data.index == 0;
      function advance() {
        let s = source();
        let m = rrMeta(s);
        let i = resource.data.index;
        let p = /databases/$(database)/documents/assessmentMarks/$(attempt)/items/$(string(i));
        return rrSource(s) && i < m.questionCount && rrAnswer(m,s.answers,i)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['index','mcPoints'])
          && request.resource.data.index == i + 1
          && (m.questions[i].type == 'short' ? request.resource.data.mcPoints == resource.data.mcPoints
            : !exists(p) && getAfter(p).data.index == i && getAfter(p).data.createdAt == request.time
              && request.resource.data.mcPoints == resource.data.mcPoints + getAfter(p).data.awarded);
      }
      allow update: if advance();
      allow list, delete: if false;
    }
    match /assessmentMarks/{attempt}/items/{index} {
      function source() { return get(/databases/$(database)/documents/submissions/$(attempt)).data; }
      allow get, list: if teacher() || owns(source().studentId);
      function validMark() {
        let s = source();
        let a = get(/databases/$(database)/documents/assessmentGrading/$(attempt)).data;
        let next = getAfter(/databases/$(database)/documents/assessmentGrading/$(attempt)).data;
        let m = rrMeta(s);
        let q = m.questions[a.index];
        let k = get(/databases/$(database)/documents/assessmentKeys/$(s.taskId + '--' + s.version)).data;
        return rrSource(s) && index == string(a.index) && q.type == 'choice' && rrAnswer(m,s.answers,a.index)
          && request.resource.data.keys().hasOnly(['index','awarded','createdAt'])
          && request.resource.data.index == a.index && request.resource.data.createdAt == request.time
          && k.questions[a.index].id == q.id
          && request.resource.data.awarded == (s.answers[a.index].value == k.questions[a.index].answer ? q.points : 0)
          && next.index == a.index + 1 && next.mcPoints == a.mcPoints + request.resource.data.awarded;
      }
      allow create: if validMark();
      allow update, delete: if false;
    }
    match /assessmentShortDrafts/{revisionId} {
      allow get: if teacher();
      allow create: if teacher()
        && request.resource.data.keys().hasOnly(['attemptId','revision','marks','createdAt'])
        && revisionId == request.resource.data.attemptId + '--' + string(request.resource.data.revision)
        && request.resource.data.revision == get(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.grade.revision + 1
        && rrSource(get(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data)
        && request.resource.data.marks is list
        && request.resource.data.marks.size() == rrMeta(get(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data).questionCount
        && request.resource.data.createdAt == request.time;
      allow update, delete, list: if false;
    }
    match /assessmentShortGrading/{revisionId} {
      function draft() { return get(/databases/$(database)/documents/assessmentShortDrafts/$(revisionId)).data; }
      allow get: if teacher();
      allow create: if teacher()
        && request.resource.data.keys().hasOnly(['index','shortPoints','markedCount'])
        && draft().marks is list && request.resource.data.index == 0
        && request.resource.data.shortPoints == 0 && request.resource.data.markedCount == 0;
      function advanceShort() {
        let d = draft();
        let s = get(/databases/$(database)/documents/submissions/$(d.attemptId)).data;
        let m = rrMeta(s);
        let i = resource.data.index;
        let mark = d.marks[i];
        let short = m.questions[i].type == 'short';
        return teacher() && rrSource(s) && i < m.questionCount
          && (short ? mark == null || (mark is number && mark >= 0 && mark <= m.questions[i].points) : mark == null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['index','shortPoints','markedCount'])
          && request.resource.data.index == i + 1
          && request.resource.data.shortPoints == resource.data.shortPoints + (mark == null ? 0 : mark)
          && request.resource.data.markedCount == resource.data.markedCount + (short && mark != null ? 1 : 0);
      }
      allow update: if advanceShort();
      allow delete, list: if false;
    }
    match /assessmentRewardQuotes/{revisionId} {
      function source(attempt) { return get(/databases/$(database)/documents/submissions/$(attempt)).data; }
      allow get: if teacher() || (resource == null && signed()) || owns(source(resource.data.attemptId).studentId);
      function startQuote() {
        let d = request.resource.data;
        let s = source(d.attemptId);
        let m = rrMeta(s);
        let a = get(/databases/$(database)/documents/assessmentGrading/$(d.attemptId)).data;
        let id = d.attemptId + '--' + string(d.revision);
        let short = m.shortCount > 0 ? get(/databases/$(database)/documents/assessmentShortGrading/$(id)).data : {'index':m.questionCount,'shortPoints':0,'markedCount':0};
        return rrSource(s) && d.keys().hasOnly(['attemptId','revision','score','amount','tierIndex','rule','checked'])
          && revisionId == id && d.revision == (('grade' in s) ? s.grade.revision + 1 : 1)
          && a.index == m.questionCount && short.index == m.questionCount && short.markedCount == m.shortCount
          && d.score == math.round(100.0 * (a.mcPoints + short.shortPoints) / m.totalPoints)
          && d.rule == rrRule(s.taskId) && d.checked == 0
          && rrQuote(d.rule,d.score,d.amount,d.tierIndex);
      }
      function advanceQuote() {
        let d = resource.data;
        let r = d.rule;
        let value = r.metric == 'score' ? d.score : 100;
        let minimum = d.tierIndex == -1 ? -1 : r.tiers[d.tierIndex].minimum;
        return rrApproved(source(d.attemptId).studentId,source(d.attemptId).taskId)
          && r.mode == 'tiers' && d.checked < r.tiers.size()
          && request.resource.data.diff(d).affectedKeys().hasOnly(['checked'])
          && request.resource.data.checked == d.checked + 1
          && rrTierBelow(r,value,minimum,d.checked);
      }
      allow create: if startQuote();
      allow update: if advanceQuote() || startQuote();
      allow delete, list: if false;
    }




    match /assessmentReviews/{attempt} {
      function source() { return get(/databases/$(database)/documents/submissions/$(attempt)).data; }
      allow get: if teacher() || owns(source().studentId);
      allow create, update: if teacher() && source().protocol == 'rules-assessment/1'
        && request.resource.data.keys().hasOnly(['revision','feedback','questions'])
        && request.resource.data.revision == source().grade.revision
        && request.resource.data.feedback is string && request.resource.data.feedback.size() <= 8000
        && request.resource.data.questions is map && request.resource.data.questions.size() <= 30;
      allow list, delete: if false;
    }
  }
}
