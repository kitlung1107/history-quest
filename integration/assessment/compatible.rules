    match /metadata/{key} { allow read, write: if teacher(); }
    // Local App integration. Answers are immutable before any grading probe.
    function rrMeta(s) {
      return get(/databases/$(database)/documents/assessmentVersions/$(s.taskId + '--' + s.version)).data;
    }
