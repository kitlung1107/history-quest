rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function teacher() {
      return signed() && request.auth.token.email == 'kitlung1107@gmail.com';
    }
    function owns(sid) {
      return signed() && (exists(/databases/$(database)/documents/access/$(request.auth.token.email))
          && get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId == sid
          && get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.enabled == true);
    }
    // This grants card selection only. It is never used by teacher(), taskAllowed(),
    // roster access or CMS. Identity comes from the verified Firebase token.
    function fullCardAccount(sid) {
      return signed()
        && request.auth.token.email in ['tangkl@ctshkpcc.edu.hk', 'kitlung1107@gmail.com']
        && (owns(sid) || (teacher() && sid == request.auth.uid
          && !exists(/databases/$(database)/documents/access/$(request.auth.token.email))));
    }
    function enabledCatalogCard(id) {
      let path = /databases/$(database)/documents/cardCatalog/current;
      return exists(path) && get(path).data.schemaVersion == 1
        && get(path).data.cards is map && id in get(path).data.cards
        && get(path).data.cards[id].enabled == true
        && get(path).data.cards[id].role in ['studentBoy', 'studentGirl'];
    }
    // Retaining an old selection is not a new grant. This lets gift top-ups and
    // teacher roster edits work after a card is removed/disabled. UI hides it.
    function retainedCard(d, sid) {
      let path = /databases/$(database)/documents/profiles/$(sid);
      return exists(path) && get(path).data.get('role', '') in ['studentBoy', 'studentGirl']
        && get(path).data.role == d.role && get(path).data.get('cardId', '') == d.cardId;
    }
    function selectedCardOK(d, sid) {
      return fullCardAccount(sid)
        ? (enabledCatalogCard(d.cardId) || retainedCard(d, sid))
        : (d.cardId in d.ownedCardIds || (teacher() && retainedCard(d, sid)));
    }
    match /cardCatalog/{card} {
      // Only the separately reviewed privileged release tool can sync metadata.
      // No client (including the existing teacher) can mint catalogue entries.
      allow get: if signed();
      allow list, write: if false;
    }
    // Grade comes only from the teacher-managed profile, never the submitted payload.
    function rosterGrade(sid) {
      let c = get(/databases/$(database)/documents/profiles/$(sid)).data.className;
      return c.matches('[ ]*([sS中]?[1一]([A-Ea-e]|班)?)[ ]*') ? 1
        : c.matches('[ ]*([sS中]?[2二]([A-Ea-e]|班)?)[ ]*') ? 2
        : c.matches('[ ]*([sS中]?[3三]([A-Ea-e]|班)?)[ ]*') ? 3
        : c.matches('[ ]*([sS中]?[4四]([A-Ea-e]|班)?)[ ]*') ? 4
        : c.matches('[ ]*([sS中]?[5五]([A-Ea-e]|班)?)[ ]*') ? 5
        : c.matches('[ ]*([sS中]?[6六]([A-Ea-e]|班)?)[ ]*') ? 6 : 0;
    }
    function gradeAllowed(sid, grade) {
      let own = rosterGrade(sid);
      return grade is int && grade >= 1 && grade <= 6
        && ((own >= 1 && own <= 3 && grade == own) || (own >= 4 && grade >= 4 && grade <= own));
    }
    function testingAccount(sid) {
      return owns(sid)
        && get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.get('testing', false) == true;
    }
    function taskAllowed(sid, task) {
      let entry = get(/databases/$(database)/documents/taskAccess/$(task)).data;
      return teacher() || (entry.enabled == true && (testingAccount(sid) || gradeAllowed(sid, entry.grade)));
    }
    match /taskAccess/{task} {
      allow read: if signed();
      allow write: if teacher() && request.resource.data.keys().hasOnly(['grade', 'enabled'])
        && request.resource.data.grade is int && request.resource.data.grade >= 1 && request.resource.data.grade <= 6
        && request.resource.data.enabled is bool;
    }
    function profileOK(d, sid) {
      return d.keys().hasOnly(['className', 'studentNo', 'name', 'nickname', 'avatar', 'configured', 'cardId', 'role', 'ownedCardIds', 'legacyCardId'])
        && (!('cardId' in d) || (d.cardId is string && d.cardId.matches('[A-Za-z0-9_-]{3,80}')))
        && (!('role' in d) || collectionOK(d, sid))
        && (!('ownedCardIds' in d) || 'role' in d)
        && (!('legacyCardId' in d) || d.legacyCardId is string)
        && d.configured is bool
        && d.className is string && d.className.matches('([1-6][A-E]|S[4-6]|Other)')
        && d.studentNo is string && d.studentNo.matches('[A-Z0-9-]{1,12}')
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 50
        && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 20
        && d.avatar in ['explorer', 'scholar', 'archaeologist', 'navigator', 'studentBoy', 'studentGirl', 'detective', 'conservator', 'ancientScholar', 'cartographer'];
    }
    function starter(d) { return d.role == 'studentBoy' ? 'starter-explorer-boy' : 'starter-explorer-girl'; }
    function gifts(d) { return [starter(d)]; }
    function collectionOK(d, sid) {
      return d.role in ['studentBoy', 'studentGirl']
        && d.ownedCardIds is list
        && d.ownedCardIds.size() == d.ownedCardIds.toSet().size()
        && selectedCardOK(d, sid);
    }
    function studentCollectionUpdate(sid) {
      let old = resource.data;
      let next = request.resource.data;
      return next.configured == true && collectionOK(next, sid)
        && (!('role' in old)
          ? (next.ownedCardIds.toSet() == old.get('ownedCardIds', []).concat(gifts(next)).toSet()
            && next.get('legacyCardId', '') == old.get('cardId', ''))
          : (next.role == old.role
            && next.ownedCardIds.toSet() == old.get('ownedCardIds', []).toSet()
            && !next.diff(old).affectedKeys().hasAny(['legacyCardId'])));
    }
    // Teacher roster edits and privileged card selection cannot mint/revoke
    // inventory. Browser draws must satisfy the separate atomic proof below.
    function teacherCollectionUpdate() {
      let old = resource.data;
      let next = request.resource.data;
      return !('role' in next)
        ? (!('role' in old) && next.get('ownedCardIds', []) == old.get('ownedCardIds', []))
        : (!('role' in old)
          ? next.ownedCardIds.toSet() == old.get('ownedCardIds', []).concat(gifts(next)).toSet()
          : (next.role == old.role && next.ownedCardIds.toSet() == old.get('ownedCardIds', []).toSet()));
    }
    // Browser-selected draw. Fair selection is a UI policy; all value and
    // ownership invariants below remain authoritative in Security Rules.
    // Trusted automatic audit accounts for every historical negative using a
    // signed reserve. Clients cannot declare their own historical funds/debt.
    function historicalDrawReserve(sid) {
      return get(/databases/$(database)/documents/cardDrawEligibility/$(sid)).data.get('legacySpent', 0);
    }
    function drawWalletAuthorized(sid) {
      let status = get(/databases/$(database)/documents/cardDraw/status).data;
      let approval = get(/databases/$(database)/documents/cardDrawEligibility/$(sid)).data;
      return status.enabled == true && status.protocolVersion == 1
        && approval.walletModel == 'immutable-positive-rewards-v1'
        && approval.openingBalance == 0 && approval.verified == true
        && approval.get('legacySpent', 0) is int && approval.get('legacySpent', 0) >= 0
        && approval.get('legacySpent', 0) <= 9007199254740991;
    }
    function emptyDrawWallet() {
      return {'schemaVersion': 1, 'balance': 0, 'credited': 0, 'spent': 0,
        'creditRevision': 0, 'drawRevision': 0, 'lastCreditId': '', 'lastRequestId': ''};
    }
    function drawWalletBefore(sid) {
      return exists(/databases/$(database)/documents/coinAccounts/$(sid))
        ? get(/databases/$(database)/documents/coinAccounts/$(sid)).data : emptyDrawWallet();
    }
    function drawWalletShape(w) {
      return w.keys().hasOnly(['schemaVersion', 'balance', 'credited', 'spent', 'creditRevision', 'drawRevision', 'lastCreditId', 'lastRequestId'])
        && w.schemaVersion == 1 && w.balance is int && w.balance >= 0
        && w.credited is int && w.credited >= 0 && w.credited <= 9007199254740991
        && w.spent is int && w.spent >= 0 && w.spent <= w.credited
        && w.balance == w.credited - w.spent
        && w.creditRevision is int && w.creditRevision >= 0 && w.creditRevision <= 9007199254740991
        && w.drawRevision is int && w.drawRevision >= 0 && w.drawRevision <= 9007199254740991
        && w.lastCreditId is string && w.lastRequestId is string;
    }
    // Each immutable positive reward can back the spend wallet exactly once.
    // This moves no coins and edits no reward: it records a verified lower bound
    // until the browser has claimed all of its existing positive ledger rows.
    function creditClaimTransition(sid, creditId) {
      let old = drawWalletBefore(sid);
      let next = getAfter(/databases/$(database)/documents/coinAccounts/$(sid)).data;
      let reward = get(/databases/$(database)/documents/coinAccounts/$(sid)/entries/$(creditId)).data;
      let proof = getAfter(/databases/$(database)/documents/coinAccounts/$(sid)/creditClaims/$(creditId)).data;
      return owns(sid) && creditId.matches('[A-Za-z0-9_-]{1,150}')
        && drawWalletShape(old) && drawWalletShape(next)
        && reward.kind in ['taskReward', 'gameReward'] && reward.amount is int && reward.amount > 0
        && !exists(/databases/$(database)/documents/coinAccounts/$(sid)/creditClaims/$(creditId))
        && proof.keys().hasOnly(['creditId', 'amount', 'revision', 'createdAt'])
        && proof.creditId == creditId && proof.amount == reward.amount
        && proof.revision == old.creditRevision + 1 && proof.createdAt == request.time
        && next.creditRevision == old.creditRevision + 1 && next.lastCreditId == creditId
        && next.credited == old.credited + reward.amount && next.balance == old.balance + reward.amount
        && next.spent == old.spent && next.drawRevision == old.drawRevision
        && next.lastRequestId == old.lastRequestId;
    }
    // Wallet forces a new receipt and matching debit. Receipt independently
    // forces the exact profile change; each artifact validates its own fields.
    // This proof graph avoids repeating every condition for all four writes.
    function browserDrawTransition(sid, requestId) {
      let old = drawWalletBefore(sid);
      let next = getAfter(/databases/$(database)/documents/coinAccounts/$(sid)).data;
      let receipt = getAfter(/databases/$(database)/documents/cardDrawReceipts/$(sid)/requests/$(requestId)).data;
      let catalog = get(/databases/$(database)/documents/cardCatalog/current).data;
      let debit = getAfter(/databases/$(database)/documents/coinAccounts/$(sid)/entries/$(('draw_' + requestId))).data;
      let price = catalog.get('drawPrice', 100);
      return owns(sid) && requestId.matches('[A-Za-z0-9_-]{3,80}')
        && old.schemaVersion == 1 && old.balance is int && old.spent is int
        && next.diff(old).affectedKeys().hasOnly(['balance', 'spent', 'drawRevision', 'lastRequestId'])
        && price is int && price >= 1 && price <= 100000 && old.balance >= price + historicalDrawReserve(sid)
        && !exists(/databases/$(database)/documents/cardDrawReceipts/$(sid)/requests/$(requestId))
        && receipt.requestId == requestId && receipt.price == price && receipt.createdAt == request.time
        && next.balance == old.balance - price && next.spent == old.spent + price
        && next.drawRevision == old.drawRevision + 1 && next.drawRevision <= 9007199254740991
        && next.lastRequestId == requestId
        && receipt.balance == next.balance - historicalDrawReserve(sid) && receipt.revision == next.drawRevision
        && debit.kind == 'cardDraw' && debit.requestId == requestId && debit.cardId == receipt.cardId
        && debit.amount == -price && debit.createdAt == request.time;
    }
    function browserDrawReceipt(sid, requestId, receipt) {
      let before = get(/databases/$(database)/documents/profiles/$(sid)).data;
      let after = getAfter(/databases/$(database)/documents/profiles/$(sid)).data;
      let catalog = get(/databases/$(database)/documents/cardCatalog/current).data;
      let wallet = getAfter(/databases/$(database)/documents/coinAccounts/$(sid)).data;
      let oldWallet = drawWalletBefore(sid);
      return owns(sid) && requestId.matches('[A-Za-z0-9_-]{3,80}')
        && receipt.keys().hasOnly(['requestId', 'cardId', 'price', 'balance', 'revision', 'role', 'catalogHash', 'clientCatalogHash', 'createdAt'])
        && receipt.requestId == requestId && receipt.cardId is string && receipt.cardId.matches('[A-Za-z0-9_-]{3,80}')
        && receipt.createdAt == request.time && receipt.price == catalog.get('drawPrice', 100)
        && catalog.schemaVersion == 1 && receipt.catalogHash == catalog.sourceSha256
        && receipt.clientCatalogHash == catalog.sourceSha256
        && before.configured == true && before.role in ['studentBoy', 'studentGirl'] && receipt.role == before.role
        && receipt.cardId in catalog.cards && catalog.cards[receipt.cardId].enabled == true
        && catalog.cards[receipt.cardId].get('drawEnabled', true) == true && catalog.cards[receipt.cardId].role == before.role
        && !(receipt.cardId in before.ownedCardIds)
        && after.ownedCardIds.size() == after.ownedCardIds.toSet().size()
        && after.ownedCardIds.toSet() == before.ownedCardIds.concat([receipt.cardId]).toSet()
        && after.diff(before).affectedKeys().hasOnly(['ownedCardIds'])
        && wallet.drawRevision == oldWallet.drawRevision + 1 && wallet.lastRequestId == requestId
        && receipt.revision == wallet.drawRevision && receipt.balance == wallet.balance - historicalDrawReserve(sid);
    }
    function browserDrawDebit(sid, entry, debit) {
      let receipt = getAfter(/databases/$(database)/documents/cardDrawReceipts/$(sid)/requests/$(debit.requestId)).data;
      return owns(sid) && debit.keys().hasOnly(['kind', 'requestId', 'cardId', 'amount', 'createdAt'])
        && debit.kind == 'cardDraw' && entry == 'draw_' + debit.requestId
        && !exists(/databases/$(database)/documents/cardDrawReceipts/$(sid)/requests/$(debit.requestId))
        && receipt.createdAt == request.time && debit.createdAt == request.time
        && debit.cardId == receipt.cardId && debit.amount == -receipt.price;
    }
    function studentBrowserDrawUpdate(sid) {
      let wallet = getAfter(/databases/$(database)/documents/coinAccounts/$(sid)).data;
      let receipt = getAfter(/databases/$(database)/documents/cardDrawReceipts/$(sid)/requests/$(wallet.lastRequestId)).data;
      return receipt.createdAt == request.time
        && !exists(/databases/$(database)/documents/cardDrawReceipts/$(sid)/requests/$(wallet.lastRequestId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownedCardIds'])
        && request.resource.data.ownedCardIds.toSet() == resource.data.ownedCardIds.concat([receipt.cardId]).toSet();
    }
    match /access/{email} {
      allow get: if teacher() || (signed() && request.auth.token.email == email);
      allow list: if teacher();
      allow create, update: if teacher() && request.resource.data.keys().hasOnly(['studentId', 'enabled', 'testing'])
        && (!('testing' in request.resource.data) || request.resource.data.testing is bool)
        && request.resource.data.studentId is string && request.resource.data.enabled is bool;
      allow delete: if teacher();
    }
    function requestIdentityOK(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 50
        && d.name.matches('.*[^ ].*')
        && d.className is string && d.className.matches('([1-3][A-E]|S[4-6]|Other)')
        && d.studentNo is string && d.studentNo.matches('[A-Z0-9-]{1,12}');
    }
    function pendingRequestOK(email) {
      return signed() && request.auth.token.email == email && !teacher()
        && (!exists(/databases/$(database)/documents/access/$(email))
          || get(/databases/$(database)/documents/access/$(email)).data.enabled == false)
        && request.resource.data.keys().hasOnly(['name', 'className', 'studentNo', 'status', 'submittedAt'])
        && requestIdentityOK(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time;
    }
    match /accessRequests/{email} {
      allow get: if teacher() || (signed() && request.auth.token.email == email);
      allow list: if teacher();
      allow create: if pendingRequestOK(email);
      allow update: if (resource.data.status == 'rejected' && pendingRequestOK(email))
        || (teacher() && resource.data.status == 'pending'
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'studentId', 'reason'])
          && ((request.resource.data.status == 'rejected'
            && request.resource.data.keys().hasOnly(['name', 'className', 'studentNo', 'status', 'submittedAt', 'reviewedAt', 'reason'])
            && request.resource.data.reason is string && request.resource.data.reason.size() >= 1 && request.resource.data.reason.size() <= 200)
          || (request.resource.data.status == 'approved'
            && request.resource.data.keys().hasOnly(['name', 'className', 'studentNo', 'status', 'submittedAt', 'reviewedAt', 'studentId'])
            && request.resource.data.studentId is string
            && profileOK(getAfter(/databases/$(database)/documents/profiles/$(request.resource.data.studentId)).data, request.resource.data.studentId)
            && getAfter(/databases/$(database)/documents/access/$(email)).data.enabled == true
            && getAfter(/databases/$(database)/documents/access/$(email)).data.studentId == request.resource.data.studentId)));
    }
    match /studentLogins/{sid} {
      allow read: if teacher() || owns(sid);
      allow create: if owns(sid)
        && exists(/databases/$(database)/documents/profiles/$(sid))
        && request.resource.data.keys().hasOnly(['firstLoginAt'])
        && request.resource.data.firstLoginAt == request.time;
      // First successful access is immutable, including across email changes.
      allow update, delete: if false;
    }
    match /profiles/{sid} {
      allow read: if teacher() || owns(sid);
      allow create: if teacher() && profileOK(request.resource.data, sid)
        && (!('role' in request.resource.data) || request.resource.data.ownedCardIds.toSet() == gifts(request.resource.data).toSet())
        && request.resource.data.className.matches('([1-3][A-E]|S[4-6]|Other)');
      allow update: if profileOK(request.resource.data, sid) && (request.resource.data.className.matches('([1-3][A-E]|S[4-6]|Other)') || request.resource.data.className == resource.data.className) && ((teacher() && teacherCollectionUpdate()) || (owns(sid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'configured', 'cardId', 'role', 'ownedCardIds', 'legacyCardId'])
        && (studentCollectionUpdate(sid) || studentBrowserDrawUpdate(sid))));
    }
    match /submissions/{attempt} {
      allow get: if teacher() || (resource == null && signed()) || owns(resource.data.studentId);
      allow list: if teacher() || owns(resource.data.studentId);
      allow create: if (teacher() || owns(request.resource.data.studentId))
        && taskAllowed(request.resource.data.studentId, request.resource.data.taskId)
        && request.resource.data.keys().hasOnly(['studentId', 'taskId', 'version', 'answers', 'createdAt'])
        && request.resource.data.taskId is string && request.resource.data.taskId.size() <= 150
        && request.resource.data.version is string && request.resource.data.version.size() <= 40
        && request.resource.data.answers is list && request.resource.data.answers.size() <= 30
        && request.resource.data.createdAt == request.time
        && (teacher() || exists(/databases/$(database)/documents/profiles/$(request.resource.data.studentId)));
      // Original answers and ownership remain immutable, including after marking.
      allow update: if teacher() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['grade']);
    }
    match /progress/{sid}/tasks/{taskId} {
      allow read: if teacher() || owns(sid);
      allow create, update: if teacher() || (owns(sid)
        && request.resource.data.keys().hasOnly(['score', 'progress', 'attemptId', 'syncedAt'])
        && request.resource.data.score == 0 && request.resource.data.progress == 100
        && request.resource.data.syncedAt == request.time
        && !exists(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId))
        && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.studentId == sid
        && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.attemptId)).data.taskId == taskId);
    }
    // Shared game protocol v1: raw answers are immutable and grading is rule-checked.
    function gameOwner(s) {
      return (teacher() || owns(s.studentId)) && request.auth.uid == s.uid;
    }
    function gameVersion(s) {
      let version = get(/databases/$(database)/documents/gameCatalog/$(s.gameId)/versions/$(s.version)).data;
      return version.enabled == true && taskAllowed(s.studentId, version.taskId);
    }
    function answerIndex(a, q, i) {
      return a.size() <= i || (a[i] is int && a[i] >= 0 && a[i] <= q.maxIndex[i]);
    }
    function gameAnswerOK(a, q) {
      return q.validator == 'index-array/1' && a is list && a.size() == q.answer.size()
        && a.size() >= 1 && a.size() <= 8
        && answerIndex(a,q,0) && answerIndex(a,q,1) && answerIndex(a,q,2) && answerIndex(a,q,3)
        && answerIndex(a,q,4) && answerIndex(a,q,5) && answerIndex(a,q,6) && answerIndex(a,q,7)
        && (!q.distinct || a.toSet().size() == a.size());
    }
    match /gameCatalog/{game}/versions/{version} {
      allow read: if signed();
      allow create: if teacher() && request.resource.data.keys().hasOnly(['enabled','title','taskId','questionCount'])
        && request.resource.data.enabled == true;
      allow update: if teacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled'])
        && request.resource.data.enabled is bool;
      match /questions/{question} {
        allow read: if signed();
        allow create: if teacher()
          && !exists(/databases/$(database)/documents/gameCatalog/$(game)/versions/$(version));
        // Identical writes permit a interrupted catalogue upload to retry.
        allow update: if teacher() && request.resource.data == resource.data;
      }
    }
    match /gameSessions/{session} {
      allow get: if teacher() || (resource == null && signed()) || owns(resource.data.studentId);
      allow list: if teacher() || owns(resource.data.studentId);
      allow create: if session.matches('[a-zA-Z0-9-]{1,80}') && gameOwner(request.resource.data)
        && gameVersion(request.resource.data)
        && (teacher() || exists(/databases/$(database)/documents/profiles/$(request.resource.data.studentId)))
        && request.resource.data.keys().hasOnly(['uid','studentId','gameId','version','status','attempts','correct','lastEventId','createdAt'])
        && request.resource.data.status == 'open' && request.resource.data.attempts == 0
        && request.resource.data.correct == 0 && request.resource.data.lastEventId == ''
        && request.resource.data.createdAt == request.time;
      function appendAnswer() {
        let next = request.resource.data;
        let path = /databases/$(database)/documents/gameSessions/$(session)/answers/$(next.lastEventId);
        let answer = getAfter(path).data;
        return next.diff(resource.data).affectedKeys().hasOnly(['attempts','correct','lastEventId'])
          && !exists(path) && next.lastEventId.matches('[a-zA-Z0-9-]{1,80}')
          && next.attempts == resource.data.attempts + 1 && answer.sequence == next.attempts
          && next.correct == resource.data.correct + (answer.correct ? 1 : 0);
      }
      function finishGame() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt'])
          && request.resource.data.status in ['completed','abandoned']
          && request.resource.data.completedAt == request.time;
      }
      allow update: if gameOwner(resource.data) && gameVersion(resource.data) && resource.data.status == 'open'
        && (finishGame() || appendAnswer());
      match /answers/{event} {
        function sessionData() { return get(/databases/$(database)/documents/gameSessions/$(session)).data; }
        function validGameAnswer() {
          let s = sessionData();
          let d = request.resource.data;
          let q = get(/databases/$(database)/documents/gameCatalog/$(s.gameId)/versions/$(s.version)/questions/$(d.questionId)).data;
          let next = getAfter(/databases/$(database)/documents/gameSessions/$(session)).data;
          return gameOwner(s) && gameVersion(s) && s.status == 'open'
            && event.matches('[a-zA-Z0-9-]{1,80}')
            && d.keys().hasOnly(['questionId','answer','correct','sequence','createdAt'])
            && d.questionId is string && gameAnswerOK(d.answer,q)
            && d.correct == (d.answer == q.answer) && d.createdAt == request.time
            && d.sequence == s.attempts + 1 && next.attempts == d.sequence
            && next.lastEventId == event;
        }
        allow read: if teacher() || owns(sessionData().studentId);
        allow create: if validGameAnswer();
      }
    }

    match /coinRules/{task} {
      function studentRewardReader() {
        let sid = get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId;
        return owns(sid) && taskAllowed(sid, task);
      }
      // Students may get settings for an authorised task only. Never expose
      // extra teacher metadata or grant collection listing / setting writes.
      allow get: if teacher() || (signed() && studentRewardReader()
        && (resource == null || resource.data.keys().hasOnly(['mode','amount','metric','tiers'])));
      allow list, write: if teacher();
    }
    match /rewardPolicies/{task} {
      function reader() {
        let sid = get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId;
        return owns(sid) && taskAllowed(sid, task);
      }
      allow get: if teacher() || (signed() && reader()
        && (resource == null || resource.data.keys().hasOnly(['source','enabled'])));
      allow list: if teacher();
      allow write: if teacher() && request.resource.data.keys().hasOnly(['source','enabled'])
        && request.resource.data.source in ['assessment','game','none'] && request.resource.data.enabled is bool;
    }
    match /rewardAutomation/{key} {
      function approved() {
        let sid = get(/databases/$(database)/documents/access/$(request.auth.token.email)).data.studentId;
        return owns(sid);
      }
      allow get: if teacher() || (key == 'status' && signed() && approved()
        && (resource == null || resource.data.keys().hasOnly(['enabled','activatedAt'])));
      allow list: if teacher();
      allow write: if false;
    }
    match /rewardResults/{sid}/attempts/{attempt} {
      allow read: if teacher() || owns(sid);
      allow write: if false;
    }
    match /trustedGameCompletions/{session} {
      allow read: if teacher() || owns(resource.data.studentId);
      allow write: if false;
    }
    match /trustedGameVerifiers/{version} {
      allow read: if teacher();
      allow write: if false;
    }
    // Local proposal: no generic wallet writes or extra administrator rights.
    match /cardDraw/{key} { allow get: if signed(); allow list, write: if false; }
    // Restricted, explicitly approved teacher certifier. A full history audit is
    // trusted to the existing verified Google Kitlung teacher; students and the
    // Tang full-card account never obtain this authority. No money is writable.
    function teacherDrawCertificate(sid) {
      let d = request.resource.data;
      let before = exists(/databases/$(database)/documents/metadata/enrollment)
        ? get(/databases/$(database)/documents/metadata/enrollment).data.get('revision', 0) : 0;
      let revision = getAfter(/databases/$(database)/documents/metadata/enrollment).data.revision;
      let access = getAfter(/databases/$(database)/documents/access/$(d.email)).data;
      return teacher() && sid.matches('[A-Za-z0-9_-]{1,150}')
        && d.keys().hasOnly(['verified','walletModel','openingBalance','legacySpent','legacyDebits','ledgerHash','entryCount','verifiedAtLedgerBalance','studentId','email','enrollmentRevision','nonce','protocol','verifiedAt'])
        && d.verified == true && d.walletModel == 'immutable-positive-rewards-v1' && d.openingBalance == 0
        && d.protocol == 'teacher-browser-ledger-audit/1' && d.verifiedAt == request.time
        && d.studentId == sid && d.email is string && d.email.size() >= 3 && d.email.size() <= 254
        && d.nonce is string && d.nonce.matches('[A-Za-z0-9_-]{3,150}')
        && d.legacySpent is int && d.legacySpent >= 0 && d.legacySpent <= 9007199254740991
        && d.legacyDebits is map && d.entryCount is int && d.entryCount >= 0 && d.entryCount <= 10000
        && d.ledgerHash is string && d.ledgerHash.matches('[a-f0-9]{64}')
        && d.verifiedAtLedgerBalance is int && d.verifiedAtLedgerBalance >= -9007199254740991 && d.verifiedAtLedgerBalance <= 9007199254740991
        && d.enrollmentRevision is int && d.enrollmentRevision == revision && revision == before + 1
        && access.studentId == sid && access.enabled == true
        && existsAfter(/databases/$(database)/documents/profiles/$(sid));
    }
    match /cardDrawEligibility/{sid} {
      allow get: if owns(sid) || teacher();
      allow create: if teacherDrawCertificate(sid);
      allow update: if resource.data.get('verified', false) != true && teacherDrawCertificate(sid);
      allow list, delete: if false;
    }
    function qualificationRequestOK(sid) {
      let d = request.resource.data;
      let status = get(/databases/$(database)/documents/cardDraw/status).data;
      return owns(sid) && sid.matches('[A-Za-z0-9_-]{1,150}')
        && status.enabled == true && status.protocolVersion == 1 && status.get('automaticQualificationEnabled', false) == true
        && d.keys().hasOnly(['studentId','uid','email','nonce','status','requestedAt'])
        && d.studentId == sid && d.uid == request.auth.uid && d.email == request.auth.token.email
        && d.nonce is string && d.nonce.matches('[A-Za-z0-9_-]{3,80}')
        && d.status == 'pending' && d.requestedAt == request.time;
    }
    match /cardDrawQualificationRequests/{sid} {
      allow get: if owns(sid) || teacher();
      allow list, delete: if false;
      allow create: if qualificationRequestOK(sid);
      allow update: if qualificationRequestOK(sid) && request.resource.data.nonce != resource.data.nonce
        && request.time >= resource.data.requestedAt + duration.value(30, 's');
    }
    match /cardDrawReceipts/{sid}/requests/{requestId} {
      allow read: if teacher() || owns(sid);
      allow create: if browserDrawReceipt(sid, requestId, request.resource.data);
      allow update, delete: if false;
    }
    match /coinAccounts/{sid} {
      allow read: if teacher() || owns(sid);
      allow create: if drawWalletAuthorized(sid) && creditClaimTransition(sid, request.resource.data.lastCreditId);
      allow update: if drawWalletAuthorized(sid) && (request.resource.data.creditRevision == resource.data.creditRevision + 1
        ? creditClaimTransition(sid, request.resource.data.lastCreditId)
        : browserDrawTransition(sid, request.resource.data.lastRequestId));
      allow delete: if false;
    }
    match /coinAccounts/{sid}/creditClaims/{creditId} {
      allow read: if teacher() || owns(sid);
      allow create: if creditClaimTransition(sid, creditId);
      allow update, delete: if false;
    }
    match /coinAccounts/{sid}/entries/{entry} {
      allow read: if teacher() || owns(sid);
      function submissionEvidence(d) {
        let s = getAfter(/databases/$(database)/documents/submissions/$(d.attemptId)).data;
        return s.studentId == sid && s.taskId == entry && s.grade.status == 'graded' && s.grade.score == d.score;
      }
      function gameEvidence(d) {
        let s = get(/databases/$(database)/documents/gameSessions/$(d.attemptId)).data;
        return s.studentId == sid && s.status == 'completed' && s.attempts > 0
          && get(/databases/$(database)/documents/gameCatalog/$(s.gameId)/versions/$(s.version)).data.taskId == entry;
      }
      // Teacher-confirmed grading is the trust boundary. Students cannot mint coins.
      // Positive rewards are immutable; only a legacy zero may be replaced.
      function positiveReward() {
        return teacher()
        && request.resource.data.keys().hasOnly(['kind','taskId','attemptId','amount','score','progress','rule','createdAt'])
        && request.resource.data.taskId == entry
        && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.progress == 100 && request.resource.data.createdAt == request.time
        && ((request.resource.data.kind == 'taskReward' && submissionEvidence(request.resource.data))
          || (request.resource.data.kind == 'gameReward' && gameEvidence(request.resource.data)));
      }
      allow create: if request.resource.data.kind == 'cardDraw'
        ? browserDrawDebit(sid, entry, request.resource.data)
        : positiveReward();
      allow update: if resource.data.amount == 0 && positiveReward();
      allow delete: if false;
    }
    match /catalogue/{task} { allow read, write: if teacher(); }
    match /roster/{student} { allow read, write: if teacher(); }
    match /metadata/{key} { allow read, write: if teacher(); }
  }
}
